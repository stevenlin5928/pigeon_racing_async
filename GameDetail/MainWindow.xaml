<Window x:Class="GameDetail.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameDetail"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920" Closing="Window_Closing">
    <Grid>
        <Border x:Name="Toast"
            Background="LawnGreen"
            CornerRadius="6"
            Padding="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,50,40,0"
            Opacity="0" Width="232">
            <TextBlock x:Name="ToastText" FontSize="14" FontFamily="Arial Black" FontWeight="Bold" Foreground="Black"/>
        </Border>

        <ComboBox x:Name="comboBox_date" HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top" Width="131" FontSize="14" FontFamily="Arial Black" FontWeight="Bold" Height="30" VerticalContentAlignment="Center"/>
        <Button x:Name="Btn_Load" Content="載入成績" HorizontalAlignment="Left" Margin="150,40,0,0" VerticalAlignment="Top" Height="30" Width="100" Click="Btn_Load_Click" FontFamily="Arial Black" FontWeight="Bold" FontSize="14"/>
        <Label x:Name="Lbl_Club" Content="Label" HorizontalAlignment="Left" Margin="260,40,0,0" VerticalAlignment="Top" Width="131" FontSize="20" FontFamily="Arial Black" Height="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBox x:Name="Txt_memberNo" HorizontalAlignment="Left" Margin="510,40,0,0" TextWrapping="Wrap" Text="會員號" VerticalAlignment="Top" Width="107" Height="30" VerticalContentAlignment="Center" FontSize="14" FontFamily="Arial Black" FontWeight="Bold"/>
        <ComboBox x:Name="comboBox_dispsn" HorizontalAlignment="Left" Margin="400,40,0,0" VerticalAlignment="Top" Width="100" FontSize="14" FontFamily="Arial Black" FontWeight="Bold" Height="30" VerticalContentAlignment="Center"/>

        <Button x:Name="Btn_Topigeon" Content="開啟鴿神" HorizontalAlignment="Left" Margin="960,40,0,0" VerticalAlignment="Top" Height="30" Width="100" Click="Btn_Topigeon_Click" FontSize="14" FontFamily="Arial Black" FontWeight="Bold"/>
        <Button x:Name="Btn_ld" Content="開啟嶺東" HorizontalAlignment="Left" Margin="1080,40,0,0" VerticalAlignment="Top" Height="30" Width="100" Click="Btn_ld_Click" FontSize="14" FontFamily="Arial Black" FontWeight="Bold" Visibility="Hidden"/>
        <Button x:Name="Btn_Cls" Content="清除畫面" HorizontalAlignment="Left" Margin="625,40,0,0" VerticalAlignment="Top" Height="30" Width="95" Click="Btn_Clean_Click" FontSize="14" FontFamily="Arial Black" FontWeight="Bold"/>
        <Button x:Name="Btn_Export" Content="匯出記錄" HorizontalAlignment="Left" Margin="725,40,0,0" VerticalAlignment="Top" Height="30" Width="95" Click="Btn_Export_Click" FontSize="14" FontFamily="Arial Black" FontWeight="Bold"/>
        <ListView x:Name="listView_record"  Margin="10,112,10,10" FontSize="16" Grid.ColumnSpan="2">
            <ListView.Resources>
                <!-- 加入格線樣式 -->
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="BorderBrush" Value="Gray"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>

                <Style TargetType="ListViewItem">
                    <Setter Property="BorderBrush" Value="LightGray"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="順序" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Serialno1}" TextWrapping="Wrap" Background="{Binding BgColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="序號" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Serialno2}" TextWrapping="Wrap" Background="{Binding BgColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="鴿會" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding ClubName}" TextWrapping="Wrap" Background="{Binding BgColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="會員" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding MemberNo}" 
                                               TextWrapping="Wrap" 
                                               MouseLeftButtonDown="MemberNo_MouseLeftButtonDown"
                                               Background="{Binding BgColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="腳環號" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding RingId}" TextWrapping="Wrap" Background="{Binding BgColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="腳環全號" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding feet_no}" TextWrapping="Wrap" Background="{Binding BgColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="日期" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding RacingDate, StringFormat={}{0:yyyy-MM-dd}}" TextWrapping="Wrap" Background="{Binding BgColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="第一套感應時間" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding ArrivedDatetime, StringFormat={}{0:HH:mm:ss.fff}}" TextWrapping="Wrap" Background="{Binding BgColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="第二套感應時間" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding FST, StringFormat={}{0:HH:mm:ss.fff}}" TextWrapping="Wrap" Background="{Binding BgColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="倒數時間" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding strcountdown_minutes}" TextWrapping="Wrap" Background="White" 
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="間隔時間" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding str_interval_minutes}" TextWrapping="Wrap" Background="White" 
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--<GridViewColumn Header="發送SMS" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding str_NotifySMS}" Foreground="Red" TextWrapping="Wrap" Background="White"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>-->
                    <GridViewColumn Header="發送SMS" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding str_NotifySMS}"
                                    Foreground="{Binding NotifyColor}"
                                        FontSize="14" FontFamily="Arial Black" FontWeight="Bold"
                                    Click="SendSms_Click"
                                    Padding="4"
                                    />      
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>


                    <GridViewColumn Header="備註" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding memo}" TextWrapping="Wrap" Background="Red" Foreground="White"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>
        <Label Content="日期"  HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black" FontWeight="Bold" Width="131" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <Label Content="鴿會" HorizontalAlignment="Left" Margin="260,10,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black" FontWeight="Bold" Width="131" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <Label Content="顯示前幾羽" HorizontalAlignment="Left" Margin="400,10,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black" FontWeight="Bold" Width="100" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <Label Content="會員號" HorizontalAlignment="Left" Margin="510,10,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black" FontWeight="Bold" Width="107" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <Label x:Name="Lbl_Message" Content="message"  HorizontalAlignment="Left" Margin="10,78,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black" FontWeight="Bold" Width="607" VerticalContentAlignment="Center"/>
        <CheckBox x:Name="CheckBox_AutoLoad" Content="自動更新" HorizontalAlignment="Left" Margin="150,17,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black" Checked="CheckBox_AutoLoad_Checked" Unchecked="CheckBox_AutoLoad_Unchecked"/>
        <TextBox x:Name="Txt_InvTime" HorizontalAlignment="Left" Margin="1114,40,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="94" Height="30"
                 VerticalContentAlignment="Center" FontSize="14" FontFamily="Arial Black" FontWeight="Bold" HorizontalContentAlignment="Center"/>
        <TextBox x:Name="Txt_AlertTime" HorizontalAlignment="Left" Margin="1224,40,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="94" Height="30"
         VerticalContentAlignment="Center" FontSize="14" FontFamily="Arial Black" FontWeight="Bold" HorizontalContentAlignment="Center"/>
        <Label Content="倒數時間" HorizontalAlignment="Left" Margin="1114,10,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black" FontWeight="Bold" Width="94" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <Label Content="警示時間" HorizontalAlignment="Left" Margin="1224,10,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black" FontWeight="Bold" Width="94" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <Label x:Name="Lbl_ReflashCountdown" Content="" HorizontalAlignment="Left" Margin="1328,17,0,0" VerticalAlignment="Top" Height="75" Width="260" FontSize="24" FontFamily="Arial Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

        <CheckBox x:Name="CheckBox_AutoSendSMS" Content="自動發送SMS" HorizontalAlignment="Left" Margin="1114,80,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black"/>
        <Button x:Name="Btn_TestSMS" Content="測試SMS"  HorizontalAlignment="Left" Margin="1648,11,0,0" VerticalAlignment="Top" Height="30" Width="100" Click="Btn_TestSMS_Click" FontSize="14" FontFamily="Arial Black" FontWeight="Bold"/>
        
    </Grid>
</Window>
