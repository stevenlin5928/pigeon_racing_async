<Window x:Class="GameDetail.login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameDetail"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="login" Height="300" Width="400">
    <Grid>
        <ComboBox x:Name="comboBox_club" HorizontalAlignment="Center" Margin="0,20,0,0" VerticalAlignment="Top" Width="250" Height="42" FontSize="18" FontFamily="Arial Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <Button x:Name="Btn_login" Content="登入" HorizontalAlignment="Center" Margin="0,200,0,0" VerticalAlignment="Top" Height="42" Width="136" FontFamily="Arial Black" FontSize="18" Click="Btn_login_Click"/>
        <TextBox x:Name="Txt_Pwd" HorizontalAlignment="Center" Height="39" Margin="0,70,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="250" FontSize="18" FontWeight="Bold" FontFamily="Arial Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <ComboBox x:Name="comboBox_made" HorizontalAlignment="Center" Margin="0,120,0,0" VerticalAlignment="Top" Width="250" Height="42" FontSize="18" FontFamily="Arial Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <Label x:Name="Lbl_Msg" Content="Label" HorizontalAlignment="Center" Margin="0,170,0,0" VerticalAlignment="Top" Width="250" FontSize="16" FontFamily="Arial Black"/>

    </Grid>
</Window>
